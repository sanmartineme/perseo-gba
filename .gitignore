# Artefactos de compilación
build/
!build/perseo.gba
*.elf
*.map
*.sav

# Salida generada por el pipeline de assets (siempre reproducible desde assets/src/ + tools/)
assets/gen/*
!assets/gen/.gitkeep
!assets/gen/sprites/.gitkeep
!assets/gen/tiles/.gitkeep
!assets/gen/soundbank/.gitkeep
!assets/gen/levels/.gitkeep

# Dependencias de terceros si se manejan por script en vez de submódulo
third_party/*
!third_party/.gitkeep

# Emuladores descargados para pruebas manuales locales (no son parte del
# proyecto ni se distribuyen con él — ver docs/TAREAS_MIGRACION_GBA.md, F0-08)
tools/emulators/

# Sistema
.DS_Store
Thumbs.db

# Cache de Python de las herramientas del pipeline
__pycache__/
*.pyc

# Builds de medicion de la Fase 9 (make BUILD=build_prof ...)
build_prof/
