# Hoja de frames de Perseo -> tiles de OBJ (sprites de hardware).
# grit lee este archivo automaticamente al convertir perseo.png.
#
#   -gt        graficos como tiles (no bitmap)
#   -gB8       8bpp: 256 colores (paleta completa para mayor definición)
#   -Mw2 -Mh2  meta-tiles de 2x2 = frames de 16x16, en el orden que espera
#              el mapeo 1D de OBJ (DCNT_OBJ_1D)
#   -pn256     exportar 256 entradas de paleta
#   -ftc -fh   salida en C + header
#
# OJO: grit no acepta comentarios al final de una linea de flags; tienen
# que ir en lineas propias como estas.
-gt
-gB8
-Mw2
-Mh2
-pn256
-ftc
-fh
